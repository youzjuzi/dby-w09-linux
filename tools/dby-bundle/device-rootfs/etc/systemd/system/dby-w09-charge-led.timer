# SPDX-License-Identifier: GPL-2.0-only
[Unit]
Description=Refresh the charging indicator once a minute
Requires=dby-w09-charge-led-off.service
After=dby-w09-charge-led-off.service

[Timer]
OnBootSec=10s
OnUnitActiveSec=60s
AccuracySec=1s
Unit=dby-w09-charge-led.service

[Install]
WantedBy=timers.target
