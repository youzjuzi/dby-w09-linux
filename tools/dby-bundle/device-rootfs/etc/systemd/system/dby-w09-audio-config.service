[Unit]
Description=Mount DBY-W09 audio configuration
After=local-fs.target
Before=display-manager.service
ConditionPathExists=!/run/modprobe.d/dby-safe-mode.conf

[Service]
Type=oneshot
ExecStart=/run/dby-device/bin/dby-w09-audio-config
RemainAfterExit=yes
TimeoutStartSec=10s
Restart=no

[Install]
WantedBy=multi-user.target
