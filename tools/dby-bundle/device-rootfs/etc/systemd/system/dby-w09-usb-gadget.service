[Unit]
Description=DBY-W09 USB2 NCM network gadget
Requires=sys-kernel-config.mount
After=sys-kernel-config.mount
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/run/dby-device/bin/dby-w09-usb-gadget
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
