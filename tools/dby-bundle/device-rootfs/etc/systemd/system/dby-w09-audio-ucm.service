[Unit]
Description=Initialize DBY-W09 microphone routes and refresh desktop audio
Requires=dby-w09-audio-config.service
After=dby-w09-audio-config.service
ConditionPathExists=!/run/modprobe.d/dby-safe-mode.conf

[Service]
Type=oneshot
ExecStart=/run/dby-device/bin/dby-w09-audio-ucm
RemainAfterExit=yes
TimeoutStartSec=90s
Restart=no
