[Unit]
Description=Extinguish the charging indicator on shutdown
Before=dby-w09-charge-led.service dby-w09-charge-led.timer

[Service]
Type=oneshot
ExecStart=/usr/bin/true
RemainAfterExit=yes
ExecStop=/run/dby-device/bin/dby-w09-charge-led --off

[Install]
WantedBy=multi-user.target
