#!/usr/bin/env -S python3 -I -B
# SPDX-License-Identifier: GPL-2.0-only
"""Allow shared RTC offset writeback only after synchronized time agrees.

Idea from CoWave-Fall's linux-on-arm-matepad11; reimplemented, no code copied.
No RTC ioctl, raw NVMEM write, or persistent p2 state is used here.
"""
from pathlib import Path
import ctypes
import sys
import time

RTC = Path('/sys/class/rtc/rtc0')
NVMEM = Path('/sys/bus/nvmem/devices')
PMIC = Path('/sys/firmware/devicetree/base/soc@0/spmi@c440000/pmic@0')

class Timeval(ctypes.Structure):
    _fields_ = [('sec', ctypes.c_long), ('usec', ctypes.c_long)]

class Timex(ctypes.Structure):
    _fields_ = [('modes', ctypes.c_uint)] + [(n, ctypes.c_long) for n in
        ('offset', 'freq', 'maxerror', 'esterror')] + [('status', ctypes.c_int)] + [
        (n, ctypes.c_long) for n in ('constant', 'precision', 'tolerance')] + [
        ('time', Timeval), ('tick', ctypes.c_long), ('ppsfreq', ctypes.c_long),
        ('jitter', ctypes.c_long), ('shift', ctypes.c_int)] + [(n, ctypes.c_long)
        for n in ('stabil', 'jitcnt', 'calcnt', 'errcnt', 'stbcnt')] + [
        ('tai', ctypes.c_int), ('reserved', ctypes.c_int * 11)]

def synchronized():
    # Native Linux LP64 ABI (target ARM64); modes=0 is a read-only query.
    if ctypes.sizeof(ctypes.c_long) != 8 or ctypes.sizeof(Timex) != 208:
        raise ValueError('unsupported ABI')
    tx = Timex()
    libc = ctypes.CDLL(None, use_errno=True)
    libc.adjtimex.argtypes = [ctypes.POINTER(Timex)]
    libc.adjtimex.restype = ctypes.c_int
    result = libc.adjtimex(ctypes.byref(tx))
    if result < 0:
        raise OSError('adjtimex query failed')
    return result != 5 and not (tx.status & 0x40)  # TIME_ERROR, STA_UNSYNC

def find_gate(rtc=RTC, devices=NVMEM, pmic=PMIC):
    """Match the actual OF provider and the RTC's four-byte cell, not an index."""
    node = pmic / 'nvram@b100'
    rtc_node = pmic / 'rtc@6000'
    cell = node / 'rtc-offset@bc'
    if ((rtc / 'device/of_node').resolve(strict=True) != rtc_node.resolve(strict=True)
            or b'qcom,spmi-sdam' not in (node / 'compatible').read_bytes().split(b'\0')
            or (node / 'reg').read_bytes() != bytes.fromhex('0000b100')
            or (node / 'read-only').read_bytes() != b''
            or (cell / 'reg').read_bytes() != bytes.fromhex('000000bc00000004')
            or (rtc_node / 'nvmem-cell-names').read_bytes() != b'offset\0'
            or (rtc_node / 'nvmem-cells').read_bytes() != (cell / 'phandle').read_bytes()
            or (rtc_node / 'allow-set-time').exists()):
        raise ValueError('unexpected RTC wiring')
    matches = [dev / 'force_ro' for dev in devices.iterdir()
               if (dev / 'of_node').resolve() == node.resolve()]
    if len(matches) != 1:
        raise ValueError('ambiguous or missing SDAM provider')
    gate = matches[0]
    if gate.read_text().strip() != '1':
        raise ValueError('SDAM is not initially read-only')
    return gate


def run(rtc=RTC, locate=find_gate, synced=synchronized, now=time.time,
        monotonic=time.monotonic, sleep=time.sleep, emit=print, timeout=600):
    deadline = monotonic() + timeout
    try:
        while not synced():
            remaining = deadline - monotonic()
            if remaining <= 0:
                emit('RTC gate: synchronization timeout; keeping read-only')
                return 0
            sleep(min(1, remaining))
        # Fail closed for missing RTC/provider or mismatched device-tree wiring.
        gate = locate()
        rtc_time = int((rtc / 'since_epoch').read_text().strip())
        delta = abs(int(now()) - rtc_time)
        if rtc_time < 0 or delta > 600:
            emit('RTC gate: 偏移不可信,保持只读 (offset untrusted; keeping read-only)')
            return 0
        if not synced() or monotonic() >= deadline:
            emit('RTC gate: synchronization changed or timed out; keeping read-only')
            return 0
        gate.write_text('0\n')
        emit(f'RTC gate: offset writeback enabled (difference {delta} s)')
    except (OSError, ValueError, OverflowError):
        emit('RTC gate: validation failed; writeback not enabled')
    return 0


if __name__ == '__main__':
    sys.exit(run())
