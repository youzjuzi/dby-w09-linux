#!/usr/bin/env -S python3 -I -B
# SPDX-License-Identifier: GPL-2.0-only
"""System-clock bootstrap using a p2 offset; never open an RTC character device."""
from pathlib import Path
import ctypes
import datetime
import fcntl
import os
import re
import sys
import tempfile
import time

LOW = 1790812800  # 2026-10-01 UTC
HIGH = 4102444800  # 2100-01-01 UTC
RTC = Path('/sys/class/rtc/rtc0')
OFFSET = Path('/var/lib/dby-w09/rtc-offset')

class Timeval(ctypes.Structure):
    _fields_ = [('sec', ctypes.c_long), ('usec', ctypes.c_long)]

class Timex(ctypes.Structure):
    _fields_ = [('modes', ctypes.c_uint)] + [(n, ctypes.c_long) for n in
        ('offset', 'freq', 'maxerror', 'esterror')] + [('status', ctypes.c_int)] + [
        (n, ctypes.c_long) for n in ('constant', 'precision', 'tolerance')] + [
        ('time', Timeval), ('tick', ctypes.c_long), ('ppsfreq', ctypes.c_long),
        ('jitter', ctypes.c_long), ('shift', ctypes.c_int)] + [(n, ctypes.c_long)
        for n in ('stabil', 'jitcnt', 'calcnt', 'errcnt', 'stbcnt')] + [
        ('tai', ctypes.c_int), ('reserved', ctypes.c_int * 11)]

def synchronized():
    # Native Linux LP64 ABI (target ARM64); modes=0 is a read-only query.
    if ctypes.sizeof(ctypes.c_long) != 8 or ctypes.sizeof(Timex) != 208:
        raise ValueError('unsupported ABI')
    tx = Timex()
    libc = ctypes.CDLL(None, use_errno=True)
    libc.adjtimex.argtypes = [ctypes.POINTER(Timex)]
    libc.adjtimex.restype = ctypes.c_int
    result = libc.adjtimex(ctypes.byref(tx))
    if result < 0:
        raise OSError('adjtimex query failed')
    return result != 5 and not (tx.status & 0x40)  # TIME_ERROR, STA_UNSYNC

def read_offset(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    with os.fdopen(fd) as stream:
        value = stream.read(128)
    if not re.fullmatch(r'-?[0-9]{1,20}\n?', value):
        raise ValueError('invalid offset')
    return int(value)

def atomic_save(path, value, owner=os.fchown):
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        raise ValueError('symlink offset')
    fd, name = tempfile.mkstemp(prefix='.rtc-offset-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            os.fchmod(stream.fileno(), 0o644)
            owner(stream.fileno(), 0, 0)
            stream.write(str(value) + '\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(name):
            os.unlink(name)

def run(mode, rtc=RTC, offset=OFFSET, now=time.time,
        monotonic=time.monotonic, sleep=time.sleep,
        set_clock=lambda t: time.clock_settime(time.CLOCK_REALTIME, t),
        synced=synchronized, write=atomic_save, emit=print, timeout=30):
    try:
        if mode == 'boot':
            deadline = monotonic() + timeout
            while True:
                try:
                    # Device/sysfs publication precedes HCTOSYS: wait for completion.
                    ready = (rtc/'hctosys').read_text().strip() == '1'
                    if ready:
                        count = int((rtc/'since_epoch').read_text().strip())
                        break
                except (OSError, ValueError):
                    pass
                remaining = deadline - monotonic()
                if remaining <= 0:
                    emit('Skipped: RTC initialization timeout');return 0
                sleep(min(.2, remaining))
            try:
                value = read_offset(offset)
            except FileNotFoundError:
                emit('Skipped: no saved clock offset');return 0
            target = count + value
            if not LOW <= target < HIGH:
                emit('Skipped: date outside supported range');return 0
            if synced():
                emit('Skipped: clock already synchronized');return 0
            set_clock(target)
            emit('Clock set: ' + datetime.datetime.fromtimestamp(target, datetime.timezone.utc).isoformat())
        elif mode == 'save':
            if not synced():
                emit('Skipped: clock not synchronized');return 0
            count = int((rtc/'since_epoch').read_text().strip())
            current = int(now())
            if not LOW <= current < HIGH or count < 0 or not synced():
                emit('Skipped: invalid or changed clock state');return 0
            value = current - count
            try:
                previous = read_offset(offset)
            except FileNotFoundError:
                previous = None
            if previous is not None and abs(value - previous) <= 2:
                emit('Skipped: clock offset unchanged');return 0
            write(offset, value)
            emit('Clock offset saved')
        else:
            emit('Skipped: unknown mode')
    except (OSError, ValueError, OverflowError):
        emit('Skipped: clock operation failed')
    return 0

def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ('boot', 'save'):
        print('Skipped: invalid arguments');return 0
    OFFSET.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(OFFSET.parent/'rtc-offset.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print('Skipped: clock helper already running');return 0
        return run(sys.argv[1])
    finally:
        os.close(fd)

if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError):
        print('Skipped: clock state directory unavailable');sys.exit(0)
