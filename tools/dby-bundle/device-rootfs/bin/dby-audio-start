#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# Initialize onboard microphones and speakers. No module unloading.
# Normally called at boot by dby-w09-audio.service; manual use is for diagnosis.
# Only one attempt per boot is allowed; reboot before another attempt.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
RUN=/run
SYS=/sys
PROC=/proc
UCM_SRC=$RUN/dby-device/ucm2/conf.d/sm8250
UCM_DST=/usr/share/alsa/ucm2/conf.d/sm8250
WP_SRC=$RUN/dby-device/wireplumber/wireplumber.conf.d
WP_DST=/etc/wireplumber/wireplumber.conf.d
umask 077
[[ $# == 0 && $(id -u) == 0 ]] || { echo 'Run as root without arguments'; exit 1; }
exec > >(tee -a "$RUN/dby-audio-start.log") 2>&1
exec 9> "$RUN/dby-audio-start.lock"
flock -n 9 || { echo 'Audio startup already active'; exit 1; }
fail() { echo "ERROR: $*; reboot before another attempt"; exit 1; }
mono() {
    local up idle
    read -r up idle < "$PROC/uptime" || return 1
    # Bound the integer part before shell arithmetic; procfs prints two decimals.
    [[ $up =~ ^[0-9]{1,12}\.[0-9]{2}$ && $idle =~ ^[0-9]+\.[0-9]{2}$ ]] || return 1
    printf '%s\n' "$((10#${up%.*} * 100 + 10#${up#*.}))"
}
[[ ! -e "$RUN/dby-audio-attempted" ]] || fail 'Audio already attempted this boot'
[[ ! -d "$SYS/module/qcom_q6v5_pas" ]] || fail 'PAS already loaded'
for remote in "$SYS"/class/remoteproc/remoteproc*; do
    [[ -r "$remote/name" ]] || continue
    if [[ $(cat "$remote/name") == *adsp* ]]; then
        [[ $(cat "$remote/state") == offline ]] || fail 'ADSP not offline'
    fi
done
: > "$RUN/dby-audio-attempted"
trap 'echo "Startup interrupted; reboot required"; exit 1' HUP INT TERM
load() { echo "modprobe $1"; timeout --signal=TERM --kill-after=2 15 modprobe "$1" || fail "Loading $1 failed/timed out"; }
echo 'Stage A: ADSP transport and APR services'
for module in qrtr-smd qcom_pd_mapper apr q6core q6afe q6asm q6adm qcom_q6v5_pas; do load "$module"; done
ready() {
    local id d found
    for id in 3 4 7 8; do
        found=0
        for d in "$SYS"/bus/aprbus/devices/aprsvc:*:4:"$id"; do
            [[ -e "$d" && -L "$d/driver" ]] && found=1
        done
        ((found)) || return 1
    done
}
echo 'Waiting up to 15 seconds for bound APR core/AFE/ASM/ADM services'
deadline=$(mono) || fail 'Invalid monotonic uptime'
deadline=$((deadline+1500))
until ready; do
    now=$(mono) || fail 'Invalid monotonic uptime'
    ((now < deadline)) || fail 'APR readiness timeout; stage B skipped'
    sleep 0.2
done
if [[ -f "$UCM_SRC/DBY-W09.conf" && -d "$UCM_DST" ]]; then
    if ! grep -Fq " $UCM_DST " "$PROC/mounts" 2>/dev/null; then
        mount --bind "$UCM_SRC" "$UCM_DST" || fail 'UCM2 bind mount failed'
        mount -o remount,bind,ro,nosuid,nodev "$UCM_DST" || fail 'UCM2 ro remount failed'
    fi
fi
# The only persistent rootfs change is creating this empty directory tree.
# Configuration stays in the device image; the read-only bind is runtime-only.
if [[ -d "$WP_SRC" ]]; then
    if [[ ! -d "$WP_DST" ]]; then
        (umask 022; mkdir -p -m 0755 "$WP_DST") || fail 'WirePlumber directory creation failed'
    fi
    if ! grep -Fq " $WP_DST " "$PROC/mounts" 2>/dev/null; then
        if [[ -n $(find "$WP_DST" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
            echo 'WARNING: WirePlumber configuration directory is not empty; speaker S16 rule skipped'
        else
            mount --bind "$WP_SRC" "$WP_DST" || fail 'WirePlumber bind mount failed'
            mount -o remount,bind,ro,nosuid,nodev "$WP_DST" || fail 'WirePlumber ro remount failed'
        fi
    fi
fi
echo 'Stage B: LPASS and onboard audio card'
for module in pinctrl-sm8250-lpass-lpi snd-soc-lpass-va-macro q6afe-clocks snd-soc-lpass-rx-macro snd-soc-lpass-tx-macro soundwire-qcom snd-soc-wcd938x-sdw snd-soc-wcd938x q6afe-dai q6asm-dai q6routing dby-tfa9874 snd-soc-sm8250; do load "$module"; done
deadline=$(mono) || fail 'Invalid monotonic uptime'
deadline=$((deadline+1500))
until grep -q 'sm8250 - DBY-W09' "$PROC/asound/cards" 2>/dev/null; do
    now=$(mono) || fail 'Invalid monotonic uptime'
    ((now < deadline)) || fail 'Onboard audio card timeout'
    sleep 0.2
done
if [[ -f "$UCM_DST/DBY-W09.conf" ]] && command -v alsaucm >/dev/null 2>&1; then
    # Verb and device state belong to one UCM manager session.
    alsaucm -c hw:DBYW09 set _verb HiFi set _enadev Mic || fail 'UCM2 Mic initialization failed'
fi
if [[ -f "$UCM_DST/DBY-W09.conf" ]] && command -v udevadm >/dev/null 2>&1; then
    udevadm trigger --action=change --subsystem-match=sound || true
fi
if [[ -f "$UCM_DST/DBY-W09.conf" ]] && command -v su >/dev/null 2>&1; then
    for rdir in "$RUN"/user/*; do
        [[ -e "$rdir/pipewire-0" ]] || continue
        uid=${rdir##*/}
        [[ $uid =~ ^[0-9]+$ ]] || continue
        user=$(id -nu "$uid" 2>/dev/null) || continue
        su - "$user" -c "XDG_RUNTIME_DIR=$rdir systemctl --user restart wireplumber" >/dev/null 2>&1 || true
    done
fi
: > "$RUN/dby-audio-ready"
echo 'DBY-W09 onboard audio card ready for capture and playback. Reboot to clean up.'
echo 'Codec probe initializes headset detection infrastructure; physical 3.5 mm interface unverified.'
