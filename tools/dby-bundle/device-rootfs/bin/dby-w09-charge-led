#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0-only
"""Update the charging indicator once, or extinguish it during shutdown."""
from pathlib import Path
import sys


def main():
    if sys.argv[1:] not in ([], ["--off"]):
        return 2
    leds = [Path("/sys/class/leds") / name
            for name in ("red:charging", "green:charging")]
    try:
        if sys.argv[1:] == ["--off"]:
            # Shutdown does not depend on the charger or fuel gauge still existing.
            for led in leds:
                try:
                    (led / "brightness").write_text("0\n")
                except FileNotFoundError:
                    pass
            return 0
        power = Path("/sys/class/power_supply")
        try:
            online = (power / "dby-chg/online").read_text().strip()
            status = (power / "dby-fg/status").read_text().strip()
            capacity = int((power / "dby-fg/capacity").read_text())
        except (OSError, ValueError):
            # The gauge can register before its first usable sample.
            return 0
        if status == "Unknown":
            return 0
        try:
            maxima = [int((led / "max_brightness").read_text()) for led in leds]
        except FileNotFoundError:
            return 0
        if not all((led / "brightness").exists() for led in leds):
            return 0
        if online != "1":
            enabled = (False, False)
        elif status == "Full" or capacity >= 90:
            enabled = (False, True)
        elif capacity < 10:
            enabled = (True, False)
        else:
            enabled = (True, True)
        # Ratios from the owner-supplied runtime FDT cust_brightness values.
        for led, maximum, ratio, on in zip(leds, maxima, (70, 120), enabled):
            brightness = max(1, (maximum * ratio + 127) // 255) if on else 0
            (led / "brightness").write_text(f"{brightness}\n")
    except (OSError, ValueError):
        print("charge-led: cannot update indicator", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
