#!/usr/bin/env -S python3 -I -B
# SPDX-License-Identifier: GPL-2.0-only
"""Install, verify or inspect an explicitly selected SD device or test image."""

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from dbyinstall.common import BundleError
from dbyinstall.core import plan
from dbyinstall.targets import BlockDeviceTarget, ImageFileTarget, parse_size


def info_json(document, *, full=False):
    if full:
        return json.dumps(document, sort_keys=True, indent=2, ensure_ascii=True)
    # Keep each boot record on one readable JSON line, including name/hash/size.
    header = json.dumps({key: value for key, value in document.items() if key != "files"},
                        sort_keys=True, indent=2, ensure_ascii=True)
    rows = ["    " + json.dumps(name) + ": " + json.dumps(row, sort_keys=True)
            for name, row in sorted(document["files"].items())]
    files = "{\n" + ",\n".join(rows) + "\n  }" if rows else "{}"
    return header[:-2] + ',\n  "files": ' + files + "\n}"


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "reinstall-system":
        from dbyinstall.reinstall_cli import main as reinstall_main
        return reinstall_main(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] in ("seed", "safe-mode"):
        from dbyinstall.seed_cli import main as seed_main
        return seed_main(sys.argv[1:])
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("install", "verify", "info", "update", "rollback"))
    choice = parser.add_mutually_exclusive_group(required=True)
    choice.add_argument("--device", type=Path)
    choice.add_argument("--image-file", type=Path)
    parser.add_argument("--image-size", help="Only for creating a test image; e.g. 8G")
    parser.add_argument("--bundle", type=Path)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--minimal", action="store_true", help="Install test rootfs with p2 defaulting to 4 GiB")
    parser.add_argument("--p2-size", help="Test root partition size, at least 1G; requires install --minimal")
    parser.add_argument("--no-readback", action="store_true", help="Skip p2 file read-back after install; retain p1 and p2 contract checks")
    parser.add_argument("--backup-dir", type=Path, help="Host directory for a new update backup (required for update)")
    parser.add_argument("--backup", type=Path, help="Verified update backup to restore (required for rollback)")
    parser.add_argument("--allow-older", action="store_true", help="Explicitly permit an older update bundle")
    parser.add_argument("--p1-only", action="store_true", help="Verify only the device package; p2 not checked")
    parser.add_argument("--full", action="store_true", help="Include the complete manifest in info output")
    args = parser.parse_args()
    try:
        if args.p1_only and args.command != "verify":
            parser.error("--p1-only applies only to verify")
        if args.full and args.command != "info":
            parser.error("--full applies only to info")
        if args.command != "install" and args.no_readback:
            parser.error("--no-readback applies only to install; use verify --p1-only for device-package checks")
        if args.command != "install" and (args.minimal or args.p2_size):
            parser.error("--minimal and --p2-size apply only to install; verify detects the installed kind")
        if args.p2_size and not args.minimal:
            parser.error("--p2-size requires --minimal")
        if args.command in ("update", "rollback"):
            if args.image_size:
                parser.error("--image-size applies only to install")
            if args.command == "update":
                if args.bundle is None or args.backup_dir is None:
                    parser.error("update requires --bundle and --backup-dir")
                if args.backup is not None:
                    parser.error("--backup applies only to rollback")
            else:
                if args.backup is None:
                    parser.error("rollback requires --backup")
                if args.bundle is not None or args.backup_dir is not None or args.allow_older:
                    parser.error("rollback accepts --backup, not update bundle options")
            from dbyinstall.maintenance import operate
            target = ImageFileTarget(args.image_file) if args.image_file else BlockDeviceTarget(args.device)
            result = operate(args.command, target, bundle=args.bundle, backup_dir=args.backup_dir,
                             backup=args.backup, dry_run=args.dry_run, allow_older=args.allow_older)
            if args.dry_run:
                print(json.dumps(result, sort_keys=True, indent=2, ensure_ascii=True))
            return 0
        if args.backup is not None or args.backup_dir is not None or args.allow_older:
            parser.error("backup options apply only to update or rollback")
        options = {"minimal": args.minimal, "p2_size": parse_size(args.p2_size) if args.p2_size else None,
                   "no_readback": args.no_readback}
        if args.image_file:
            from dbyinstall import image as backend
            target = ImageFileTarget(args.image_file, parse_size(args.image_size) if args.image_size else 0)
        else:
            from dbyinstall import privileged as backend
            if args.image_size:
                parser.error("--image-size requires --image-file")
            target = BlockDeviceTarget(args.device)
            if not args.dry_run:
                backend.require_root()
        if args.command in ("install", "verify") and args.bundle is None:
            parser.error("--bundle is required")
        if args.dry_run:
            if args.command == "install":
                preview = plan(target, args.bundle, image=bool(args.image_file), **options)[0]
            else:
                target.validate(existing=True) if args.image_file else target.validate()
                preview = {"action": args.command, "target": str(target.path), "readonly": True,
                           "steps": ["validate table and labels", "open filesystems read-only", "inspect metadata or hash bundle files", "close filesystems"]}
                if args.p1_only:
                    preview.update(p2_checked=False, steps=["validate table and labels", "open p1 read-only",
                                                           "hash five boot files and compare manifests", "close p1; p2 not checked"])
            print(json.dumps(preview, sort_keys=True, indent=2, ensure_ascii=True))
        elif args.command == "info":
            print(info_json(backend.info(target, full=args.full), full=args.full))
        elif args.command == "verify":
            backend.verify(target, args.bundle, p1_only=args.p1_only)
            print("OK: p1 matches the bundle; p2 not checked." if args.p1_only
                  else "OK: installed files match the bundle.")
        else:
            if args.image_file:
                print(json.dumps(plan(target, args.bundle, image=True, **options)[0], sort_keys=True, indent=2))
            backend.install(target, args.bundle, **options)
            print("OK: install completed; p2 file read-back skipped." if args.no_readback
                  else "OK: install and read-back verification completed.")
        return 0
    except BundleError as error:
        print(error, file=sys.stderr); return 1
    except (OSError, ValueError, KeyError, TypeError):
        print("E_INSTALL_IO: Installer input or operation failed; raw details withheld.", file=sys.stderr); return 1


if __name__ == "__main__":
    sys.exit(main())
